<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Debug dev convenience: pull XRDBridge.dll straight from the local
         Swift debug build output, so `dotnet test`/`dotnet run` work without
         windows/scripts/build.ps1. Debug-only so it never collides with
         XRDAnalyzer.csproj's Release packaging, which stages its own
         (release-built) XRDBridge.dll from Redist\ instead. -->
    <XRDBridgeDll>$(MSBuildThisFileDirectory)..\..\native\.build\x86_64-unknown-windows-msvc\debug\XRDBridge.dll</XRDBridgeDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' and Exists('$(XRDBridgeDll)')">
    <None Include="$(XRDBridgeDll)" Link="XRDBridge.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
