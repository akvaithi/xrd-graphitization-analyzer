<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="XRDAnalyzer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:XRDAnalyzer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="XRD Graphitization Analyzer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <TabView x:Name="TabControl" IsAddTabButtonVisible="False" VerticalAlignment="Stretch">
            <TabView.TabStripFooter>
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Button x:Name="SuggestAllButton" Grid.Column="0" Content="AI Suggest All" Margin="8,4" Click="SuggestAllButton_Click" />
                    <Button x:Name="ExportAllButton" Grid.Column="1" Content="Export All…" Margin="0,4" Click="ExportAllButton_Click" />
                    <Grid x:Name="CustomDragRegion" Grid.Column="2" />
                </Grid>
            </TabView.TabStripFooter>
            <TabViewItem x:Name="AnalyzeTab" Header="Analyze" IsClosable="False" />
            <TabViewItem x:Name="CompareTab" Header="Compare" IsClosable="False" />
            <TabViewItem x:Name="StackTab" Header="Stack spectra" IsClosable="False" />
            <TabViewItem x:Name="ManualTab" Header="Manual calc" IsClosable="False" />
            <TabViewItem x:Name="YieldTab" Header="Yield" IsClosable="False" />
        </TabView>

        <Border x:Name="BatchBanner" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="14,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressBar x:Name="BatchProgressBar" Width="120" Minimum="0" Maximum="1" />
                <TextBlock x:Name="BatchNoteText" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="DismissBatchButton" Content="✕" Padding="6,2" Click="DismissBatchButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
