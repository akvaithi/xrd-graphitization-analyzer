<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XRDAnalyzer.Views.StackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="using:ScottPlot.WinUI"
    mc:Ignorable="d">

    <Grid>
        <TextBlock x:Name="EmptyStateText" Text="No spectra. Open .xy files to overlay them here."
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />

        <Grid x:Name="ContentGrid" RowDefinitions="Auto,*" Visibility="Collapsed">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Padding="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Offset" VerticalAlignment="Center" />
                    <Slider x:Name="OffsetSlider" Minimum="0" Maximum="1" StepFrequency="0.01" Width="160" ValueChanged="Control_Changed" />
                    <TextBlock x:Name="OffsetValueText" VerticalAlignment="Center" Opacity="0.7" Width="36" />
                </StackPanel>
                <ToggleSwitch x:Name="ZoomToggle" OnContent="Zoom (002) 24-30°" OffContent="Zoom (002) 24-30°" Toggled="Control_Changed" />
                <ToggleSwitch x:Name="BaselineToggle" OnContent="Baseline subtract" OffContent="Baseline subtract" Toggled="Control_Changed" />
                <Button Content="Chart PNG" Click="ChartPngButton_Click" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,300">
                <Grid Grid.Column="0" Padding="12">
                    <sp:WinUIPlot x:Name="ChartControl" />
                    <TextBlock x:Name="NoSeriesText" Text="Check files to stack" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="8" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,4,4,8">
                        <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" FontSize="12" />
                        <Button Content="all" Click="SelectAllButton_Click" FontSize="11" />
                        <Button Content="none" Click="SelectNoneButton_Click" FontSize="11" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="FilesList" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
