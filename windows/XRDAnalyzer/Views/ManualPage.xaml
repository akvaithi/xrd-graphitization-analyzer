<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XRDAnalyzer.Views.ManualPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="380,*">
        <ScrollViewer Grid.Column="0" Padding="16">
            <StackPanel Spacing="14">
                <TextBlock Text="Enter Origin fit peaks" FontSize="16" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="TwoPeaksToggle" Header="Two peaks (graphitic + turbostratic)" Toggled="TwoPeaksToggle_Toggled" />

                <TextBlock Text="GRAPHITIC" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumberBox x:Name="Xc1Box" PlaceholderText="xc (2θ °)" Width="150" SpinButtonPlacementMode="Compact" />
                    <NumberBox x:Name="A1Box" PlaceholderText="area (A)" Width="150" SpinButtonPlacementMode="Compact" />
                </StackPanel>

                <StackPanel x:Name="TurboPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="TURBOSTRATIC" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <NumberBox x:Name="Xc2Box" PlaceholderText="xc (2θ °)" Width="150" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="A2Box" PlaceholderText="area (A)" Width="150" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                           Text="λ fixed at Cu Kα 1.54187 Å. Graphitic = higher 2θ peak. One peak → DG from its d-spacing; two → area-weighted (Maire–Mering)." />

                <Button x:Name="CalculateButton" Content="Calculate DG%" Click="CalculateButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1" Padding="16">
            <Grid>
                <TextBlock x:Name="EmptyStateText" Text="Type 1 or 2 peaks and calculate." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                <StackPanel x:Name="ResultPanel" Spacing="16" Visibility="Collapsed">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="0,16">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="Degree of Graphitization" FontSize="11" HorizontalAlignment="Center" Foreground="White" Opacity="0.85" />
                            <TextBlock x:Name="DgValueText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" />
                            <TextBlock x:Name="MethodText" FontSize="11" HorizontalAlignment="Center" Foreground="White" Opacity="0.85" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ResultRowsPanel" Spacing="12" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
