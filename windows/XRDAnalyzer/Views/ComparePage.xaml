<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XRDAnalyzer.Views.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="using:ScottPlot.WinUI"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="EmptyStateText" Grid.RowSpan="2" Text="No runs to compare. Open .xy files; each is auto-fit, then compare them here."
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />

        <Grid x:Name="ContentGrid" Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,*" Visibility="Collapsed">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="10" VerticalAlignment="Center">
                <ComboBox x:Name="YMetricCombo" Header="Y" SelectionChanged="Metric_SelectionChanged" />
                <ComboBox x:Name="XMetricCombo" Header="X" SelectionChanged="Metric_SelectionChanged" />
                <ComboBox x:Name="GroupCombo" Header="Color" SelectionChanged="Metric_SelectionChanged" />
                <Button Content="Chart PNG" Click="ChartPngButton_Click" VerticalAlignment="Bottom" />
                <Button Content="CSV" Click="CsvButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,300">
                <Grid Grid.Column="0" Padding="12">
                    <sp:WinUIPlot x:Name="ChartControl" />
                    <TextBlock x:Name="NoPointsText" Text="No points for this combination" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="8" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,4,4,8">
                        <TextBlock x:Name="RunCountText" VerticalAlignment="Center" FontSize="12" />
                        <Button Content="all" Click="ShowAllButton_Click" FontSize="11" />
                        <Button Content="none" Click="ShowNoneButton_Click" FontSize="11" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="RunList" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
